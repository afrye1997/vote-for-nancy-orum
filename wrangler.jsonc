{
  // Cloudflare Pages, deployed by direct upload — no Git integration.
  //
  //   npm run deploy      builds, then uploads ./dist
  //
  // There is no `main` entry script and no Worker: every URL is a complete HTML
  // file written by scripts/prerender.mjs at build time, so Cloudflare only has
  // to hand out files.
  //
  // ───────────────────────────────────────────────────────────────────────────
  // ENVIRONMENT VARIABLES DO NOT BELONG HERE
  // ───────────────────────────────────────────────────────────────────────────
  // WEB3FORMS_KEY, TURNSTILE_SITE_KEY and SITE_ORIGIN are read by the BUILD and
  // baked into the HTML. With direct upload the build runs on this machine, so
  // they go in the shell that runs `npm run deploy`, not in the Cloudflare
  // dashboard:
  //
  //   WEB3FORMS_KEY=… TURNSTILE_SITE_KEY=… SITE_ORIGIN=https://… npm run deploy
  //
  // Dashboard variables would only matter if Cloudflare were doing the build,
  // which it is not. Setting them there and expecting them to apply is the easy
  // mistake — the deploy would silently ship the "form isn't connected" card.
  //
  // ───────────────────────────────────────────────────────────────────────────
  // 404s
  // ───────────────────────────────────────────────────────────────────────────
  // Pages serves dist/404.html for an unknown path with a real 404 status,
  // automatically, because the file exists. Nothing to configure — and notably
  // NOT an SPA fallback, which would return the homepage with a 200 for every
  // mistyped URL and tell crawlers that every address on the domain exists.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vote-for-nancy-orum",
  "compatibility_date": "2026-08-10",
  "pages_build_output_dir": "./dist"
}
